class Solution {
    // greedy, TC - O(N), SC - O(1)
    public boolean canJump(int[] nums) {
        int farthest = 0;
        for(int i = 0;i < nums.length;i++){
            if(i > farthest) return false;
            farthest = Math.max(farthest, i+nums[i]);
        }
        return true;
    }

    public boolean cannnnJump(int[] nums) {
        boolean dp[] = new boolean[nums.length];
        return solve(nums, 0, dp);
    }

    // memoization (top-down DP), TC - O(N^2), SC - O(2N)
    private boolean solve(int[] nums, int i, boolean dp[]){
        if(i >= nums.length - 1) return true;
        if(dp[i] != false) return dp[i];

        for(int j = 1;j <= nums[i]; j++){
            if(solve(nums, i+j, dp)) return dp[i] = true;
        }
        return dp[i] = false;
    }


    // Recursion, TC - O(2^N), SC - O(N)
    private boolean solve(int[] nums, int i){
        if(i >= nums.length - 1) return true;

        for(int j = 1;j <= nums[i]; j++){
            if(solve(nums, i+j)) return true;
        }
        return false;
    }
}
