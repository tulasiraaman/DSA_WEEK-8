class Solution {
    // optimized: TC - O(N), SC - O(1)
    public int numDecodings(String s) {
    int n = s.length();
    if (n == 0 || s.charAt(0) == '0') return 0;
    int prev2 = 1, prev1 = 1; // dp[i-2], dp[i-1]

    for (int i = 1; i < n; i++) {
        int curr = 0;
        // Single digit decode
        if (s.charAt(i) != '0')
            curr += prev1;

        // Double digit decode
        int twoDig = Integer.parseInt(s.substring(i-1, i+1));
        if (twoDig >= 10 && twoDig <= 26)
            curr += prev2;

        // Shift states
        prev2 = prev1;
        prev1 = curr;
    }
    return prev1;
}
    
    // tabulation: TC - O(N), SC - O(N)
    public int numDecodingggggs(String s) {
        int n = s.length();
        int[] dp = new int[n+2];
        dp[0] = 1;

        for(int i = 1;i <= n;i++){
            if(s.charAt(i-1) != '0')
                dp[i] += dp[i-1]; // single digit decode

            if(i > 1 && s.charAt(i-2) != '0') {
                int twoDig = Integer.parseInt(s.substring(i-2, i));
                if(twoDig <= 26)
                    dp[i] += dp[i-2]; // double digit decode
            }
        }
        return dp[n];
    }

    public int numDecodingssssss(String s) {
        int n = s.length();
        int[] dp = new int[n];
        Arrays.fill(dp, -1);
        return backtrack(s, 0, n, dp);
    }

    // Pure recursion: TC - O(2^N), SC - O(N)
    private int backtrack(String s, int i, int n) {
        if(i == n) return 1;
        if(s.charAt(i) == '0') return 0;

        int ways = backtrack(s, i+1, n); // pick 1 number
        if(i + 1 < n && Integer.parseInt(s.substring(i, i+2)) <= 26)
            ways += backtrack(s, i+2, n); // pick 2 numbers
        return ways;
    }

    // memoization: TC - O(N), SC - O(N)
    private int backtrack(String s, int i, int n, int[] dp) {
        if(i == n) return 1;
        if(s.charAt(i) == '0') return 0;
        if(dp[i] != -1) return dp[i];

        int ways = backtrack(s, i+1, n, dp); // pick 1 number
        if(i + 1 < n && Integer.parseInt(s.substring(i, i+2)) <= 26)
            ways += backtrack(s, i+2, n, dp); // pick 2 numbers
        return dp[i] = ways; // store and return
    }
}
